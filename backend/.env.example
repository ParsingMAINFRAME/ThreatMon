# Copy to backend/.env for native development. Defaults work without this file.
APP_NAME="Threat Situation Room"
APP_ENV=local
DATABASE_URL=sqlite:///./threat_situation_room.db
ALLOWED_ORIGINS=["http://localhost:3000"]
CREATE_DB_ON_STARTUP=true
SEED_DEMO_DATA=true
NEWS_SNAPSHOT_PATH=./.artifacts/news/nasa-snapshot.json

# Optional Postgres, started with `docker compose --profile postgres up -d postgres`:
# DATABASE_URL=postgresql+psycopg://threatroom:threatroom@localhost:5432/threatroom

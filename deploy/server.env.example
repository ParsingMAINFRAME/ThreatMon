# setup-server.sh copies this to deploy/.env (not committed). A host name that resolves to this server.
# Without a domain, use the server's public IP with dashes plus .sslip.io, e.g. 203-0-113-5.sslip.io
SITE_ADDRESS=
# Seed the visibly labeled demo scenarios alongside live data.
SEED_DEMO_DATA=true
# Seconds between news polling cycles (900–86400).
NEWS_POLL_INTERVAL_SECONDS=900
